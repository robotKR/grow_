import re
import sys
from datetime import date, timedelta

streak = 0
prev = None
total = 0

tree_mode = False
for arg in sys.argv[1:]:
    if arg == "-t":
        tree_mode = True
    else:
        print("grow: unknown option: " + arg, file=sys.stderr)
        sys.exit(1)

STAGES = [
    (0, "seed"),
    (30, "sprout"),
    (100, "leaf"),
    (250, "sapling"),
    (500, "tree"),
]

TREES = {
    "seed": ["", "", "   .", "~~~~~~~"],
    "sprout": ["", "   ,", "  \\|/", "~~~~~~~"],
    "leaf": ["  \\ /", " --*--", "   |", "~~~~~~~"],
    "sapling": [" *****", "  ***", "   |", "~~~~~~~"],
    "tree": ["*******", " *****", "   ||", "~~~~~~~"],
}

for line in sys.stdin:
    text = line.strip()
    if text == "":
        continue
    try:
        if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", text):
            raise ValueError
        day = date.fromisoformat(text)
    except ValueError:
        print("grow: invalid date: " + text, file=sys.stderr)
        sys.exit(1)
    if prev is not None and day == prev + timedelta(days=1):
        streak += 1
    else:
        streak = 1
    prev = day

    m = round(1.0 + 0.1 * (streak - 1), 1)
    if m > 3.0:
        m = 3.0
    gain = round(10 * m)
    total += gain

    for a,b in STAGES:
        if total >= a:
            stage = b
    if not tree_mode:
        print(day, streak, m, gain, total, stage)

if prev is None:
    print("grow: no dates in input", file=sys.stderr)
    sys.exit(1)

if tree_mode:
    for row in TREES[stage]:
        print(row)
    print(stage, total)