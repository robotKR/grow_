import sys
from datetime import date, timedelta

streak = 0
prev = None
total = 0

STAGES = [
    (0, "seed"),
    (30, "sprout"),
    (100, "leaf"),
]

for line in sys.stdin:
    text = line.strip()
    if text == "":
        continue
    try:
        day = date.fromisoformat(text)
    except ValueError:
        print("grow: invalid date: " + text, file=sys.stderr)
        sys.exit(1)
    if prev is not None and day == prev + timedelta(days=1):
        streak += 1
    else:
        streak = 1
    prev = day

    m = round(1.0 + 0.1 * (streak - 1), 1)
    if m > 3.0:
        m = 3.0
    gain = round(10 * m)
    total += gain

    for a,b in STAGES:
        if total >= a:
            stage = b
    print(day, streak, m, gain, total,stage)
